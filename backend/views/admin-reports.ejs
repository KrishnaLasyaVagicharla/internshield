<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0f172a;
      --sidebar: #1e293b;
      --card: #1e293b;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --success: #10b981;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }
    .sidebar { width: 260px; background: var(--sidebar); border-right: 1px solid var(--border); padding: 24px 20px; display: flex; flex-direction: column; }
    .brand { font-size: 1.25rem; font-weight: 800; color: #60a5fa; margin-bottom: 30px; display: flex; align-items: center; gap: 8px; }
    .nav-links { list-style: none; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .nav-links a { color: var(--muted); text-decoration: none; padding: 10px 14px; border-radius: 6px; display: block; font-weight: 500; font-size: 0.95rem; }
    .nav-links a.active, .nav-links a:hover { background: rgba(59, 130, 246, 0.15); color: #fff; }
    .user-footer { border-top: 1px solid var(--border); padding-top: 16px; font-size: 0.85rem; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
    
    .main { flex: 1; padding: 32px 40px; overflow-y: auto; }
    .header { margin-bottom: 28px; }
    .header h1 { font-size: 1.8rem; font-weight: 700; }
    .msg-alert { background: rgba(16, 185, 129, 0.2); border: 1px solid var(--success); color: #6ee7b7; padding: 12px 18px; border-radius: 6px; margin-bottom: 20px; font-size: 0.9rem; }
    
    .table-container { background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
    th { background: #162032; padding: 12px 18px; color: var(--muted); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; }
    td { padding: 14px 18px; border-top: 1px solid var(--border); vertical-align: middle; }
    .status-badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-transform: capitalize; }
    .status-approved { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .status-pending { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .status-rejected { background: rgba(239, 68, 68, 0.2); color: #f87171; }
    
    .btn-action { border: none; padding: 6px 12px; border-radius: 4px; font-weight: 600; font-size: 0.8rem; cursor: pointer; transition: opacity 0.2s; }
    .btn-approve { background: var(--success); color: #fff; }
    .btn-reject { background: var(--danger); color: #fff; }
    .btn-action:hover { opacity: 0.85; }
    .form-inline { display: inline-block; margin-right: 6px; }
    .empty-state { padding: 40px; text-align: center; color: var(--muted); }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="brand">InternShield</div>
    <ul class="nav-links">
      <li><a href="/admin">Overview Dashboard</a></li>
      <li><a href="/admin/reports" class="active">Moderation Reports</a></li>
      <li><a href="/admin/internships/new">+ Post Internship</a></li>
      <li><a href="/about" target="_blank">Public About (SSR)</a></li>
      <li><a href="http://localhost:5173" target="_blank">React Student Portal &rarr;</a></li>
    </ul>
    <div class="user-footer">
      <span><%= user ? user.name : 'Admin' %></span>
      <a href="/admin/logout" style="color: var(--danger); text-decoration: none;">Logout</a>
    </div>
  </aside>

  <main class="main">
    <div class="header">
      <h1>Fraud Report Moderation Queue</h1>
      <p style="color: var(--muted); font-size: 0.95rem; margin-top: 4px;">Demonstrating HTML Form handling (POST) in EJS (Syllabus Exp 2)</p>
    </div>

    <% if (message) { %>
      <div class="msg-alert"><%= message %></div>
    <% } %>

    <div class="table-container">
      <% if (reports && reports.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Type</th>
              <th>Target Identifier</th>
              <th>Reported Reason</th>
              <th>Reporter</th>
              <th>Status</th>
              <th>Actions (HTML Form POST)</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(function(r) { %>
              <tr>
                <td><strong><%= r.type.toUpperCase() %></strong></td>
                <td><code><%= r.value %></code></td>
                <td><%= r.reason %></td>
                <td><%= r.reportedBy ? r.reportedBy.name + ' (' + r.reportedBy.email + ')' : 'Anonymous' %></td>
                <td><span class="status-badge status-<%= r.status %>"><%= r.status %></span></td>
                <td>
                  <% if (r.status === 'pending') { %>
                    <form action="/admin/reports/<%= r._id %>" method="POST" class="form-inline">
                      <input type="hidden" name="action" value="approve">
                      <button type="submit" class="btn-action btn-approve">&#10003; Approve (Blacklist)</button>
                    </form>
                    <form action="/admin/reports/<%= r._id %>" method="POST" class="form-inline">
                      <input type="hidden" name="action" value="reject">
                      <button type="submit" class="btn-action btn-reject">&#10005; Reject</button>
                    </form>
                  <% } else { %>
                    <span style="color: var(--muted); font-size: 0.85rem;">Resolved (<%= r.status %>)</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">No student fraud reports submitted yet.</div>
      <% } %>
    </div>
  </main>
</body>
</html>
