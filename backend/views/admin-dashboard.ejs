<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0f172a;
      --sidebar: #1e293b;
      --card: #1e293b;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }
    
    /* Sidebar */
    .sidebar { width: 260px; background: var(--sidebar); border-right: 1px solid var(--border); padding: 24px 20px; display: flex; flex-direction: column; }
    .brand { font-size: 1.25rem; font-weight: 800; color: #60a5fa; margin-bottom: 30px; display: flex; align-items: center; gap: 8px; }
    .nav-links { list-style: none; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .nav-links a { color: var(--muted); text-decoration: none; padding: 10px 14px; border-radius: 6px; display: block; font-weight: 500; font-size: 0.95rem; }
    .nav-links a.active, .nav-links a:hover { background: rgba(59, 130, 246, 0.15); color: #fff; }
    .user-footer { border-top: 1px solid var(--border); padding-top: 16px; font-size: 0.85rem; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
    .logout-btn { color: var(--danger); text-decoration: none; font-weight: 600; }

    /* Main Content */
    .main { flex: 1; padding: 32px 40px; overflow-y: auto; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
    .header h1 { font-size: 1.8rem; font-weight: 700; }
    .actions { display: flex; gap: 12px; }
    .btn { background: var(--primary); color: #fff; text-decoration: none; padding: 9px 18px; border-radius: 6px; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
    .btn:hover { opacity: 0.9; }

    /* Stat Cards */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 36px; }
    .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }
    .stat-label { font-size: 0.85rem; color: var(--muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 8px; }
    .stat-value { font-size: 2rem; font-weight: 800; color: #fff; }

    /* Tables */
    .section-title { font-size: 1.2rem; font-weight: 700; margin-bottom: 16px; color: #cbd5e1; }
    .table-container { background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin-bottom: 32px; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
    th { background: #162032; padding: 12px 18px; color: var(--muted); font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; }
    td { padding: 14px 18px; border-top: 1px solid var(--border); }
    .status-badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-transform: capitalize; }
    .status-approved { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .status-pending { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .status-rejected { background: rgba(239, 68, 68, 0.2); color: #f87171; }
    .empty-state { padding: 30px; text-align: center; color: var(--muted); }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      InternShield
    </div>
    <ul class="nav-links">
      <li><a href="/admin" class="active">Overview Dashboard</a></li>
      <li><a href="/admin/reports">Moderation Reports (<%= stats.pendingReports %>)</a></li>
      <li><a href="/admin/internships/new">+ Post Internship</a></li>
      <li><a href="/about" target="_blank">Public About (SSR)</a></li>
      <li><a href="http://localhost:5173" target="_blank">React Student Portal &rarr;</a></li>
    </ul>
    <div class="user-footer">
      <span><%= user ? user.name : 'Admin' %></span>
      <a href="/admin/logout" class="logout-btn">Logout</a>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="main">
    <div class="header">
      <div>
        <h1>Administrative Command Center</h1>
        <p style="color: var(--muted); font-size: 0.95rem; margin-top: 4px;">Demonstrating EJS Server-Side Rendering (Syllabus Exp 2)</p>
      </div>
      <div class="actions">
        <a href="/admin/internships/new" class="btn">+ Add Verified Internship</a>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Active Students</div>
        <div class="stat-value"><%= stats.students %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Postings</div>
        <div class="stat-value"><%= stats.internships %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Verified Listings</div>
        <div class="stat-value" style="color: #34d399;"><%= stats.verified %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Pending Scam Reports</div>
        <div class="stat-value" style="color: #fbbf24;"><%= stats.pendingReports %></div>
      </div>
    </div>

    <!-- Recent Postings Table (EJS Loop) -->
    <h2 class="section-title">Recent Internship Listings</h2>
    <div class="table-container">
      <% if (recentInternships && recentInternships.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Role</th>
              <th>Company</th>
              <th>Mode</th>
              <th>Stipend</th>
              <th>Trust Score</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% recentInternships.forEach(function(item) { %>
              <tr>
                <td><strong><%= item.title %></strong></td>
                <td><%= item.company %></td>
                <td style="text-transform: capitalize;"><%= item.mode %></td>
                <td><%= item.stipend ? '₹' + item.stipend.toLocaleString() : 'Unpaid' %></td>
                <td>
                  <span style="font-weight: 700; color: <%= item.trustScore >= 70 ? '#34d399' : (item.trustScore >= 40 ? '#fbbf24' : '#f87171') %>;">
                    <%= item.trustScore %>/100
                  </span>
                </td>
                <td>
                  <% if (item.verified) { %>
                    <span class="status-badge status-approved">Verified Real</span>
                  <% } else { %>
                    <span class="status-badge status-rejected">Unverified</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">No internships found in the database. Run seed script.</div>
      <% } %>
    </div>

    <!-- Recent Scam Reports Table -->
    <h2 class="section-title">Latest Student Scam Reports</h2>
    <div class="table-container">
      <% if (recentReports && recentReports.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Type</th>
              <th>Reported Value</th>
              <th>Reported By</th>
              <th>Reason</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% recentReports.forEach(function(r) { %>
              <tr>
                <td style="text-transform: uppercase; font-size: 0.8rem; font-weight: 700;"><%= r.type %></td>
                <td><code><%= r.value %></code></td>
                <td><%= r.reportedBy ? r.reportedBy.name : 'Anonymous' %></td>
                <td><%= r.reason %></td>
                <td><span class="status-badge status-<%= r.status %>"><%= r.status %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">No pending fraud reports submitted.</div>
      <% } %>
    </div>
  </main>
</body>
</html>
